&CONTROL
  calculation   = 'scf'
  outdir        = './out/'
  prefix        = 'nm'
  pseudo_dir    = './pseudo/'
  verbosity     = 'high'
/

&SYSTEM
  ibrav         = 6
  celldm(1)     = 8.910991
  celldm(3)     = 0.674649
  nat           = 6
  ntyp          = 3
  nspin         = 1
  nosym         = .false.
  ecutwfc       = 90.0
  ecutrho       = 1080.0
  occupations   = 'smearing'
  smearing      = 'cold'
  degauss       = 0.01
/

&ELECTRONS
  conv_thr         = 1.0d-09
  electron_maxstep = 100
  mixing_beta      = 0.3
  diagonalization  = 'cg'
/

ATOMIC_SPECIES
  Co1  58.933195  co_pbesol_v1.2.uspp.F.UPF
  Co2  58.933195  co_pbesol_v1.2.uspp.F.UPF
  F    18.998403  F.oncvpsp.upf

ATOMIC_POSITIONS crystal
  Co1  0.0000000000  0.0000000000  0.0000000000
  Co2  0.5000000000  0.5000000000  0.5000000000
  F    0.1957467430  0.8042532570  0.5000000000
  F    0.8042532570  0.1957467430  0.5000000000
  F    0.6957467430  0.6957467430  0.0000000000
  F    0.3042532570  0.3042532570  0.0000000000

K_POINTS automatic
  8 8 12 0 0 0

HUBBARD ortho-atomic
  U Co1-3d 6.26
  U Co2-3d 6.26