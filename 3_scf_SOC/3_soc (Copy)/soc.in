&CONTROL
  calculation   = 'scf'
  outdir        = './out/'
  prefix        = 'soc'
  pseudo_dir    = './pseudo/'
  verbosity     = 'high'
/

&SYSTEM
  ibrav         = 6
  celldm(1)     = 8.910991
  celldm(3)     = 0.674649
  nat           = 6
  ntyp          = 3
  noncolin      = .true.
  lspinorb      = .true.
  nosym         = .false.
  ecutwfc       = 90.0
  ecutrho       = 1080.0
  occupations = 'smearing'
  smearing    = 'gaussian'
  degauss     = 0.001
  starting_magnetization(1) = 0.5
  angle1(1)     = 90.0
  angle2(1)     = 45.0
  starting_magnetization(2) = 0.5
  angle1(2)     = 90.0
  angle2(2)     = 225.0
  starting_magnetization(3) = 0.0
/

&ELECTRONS
  conv_thr         = 1.0d-09
  electron_maxstep = 150
  mixing_beta      = 0.1
  mixing_ndim      = 15
  mixing_mode      = 'local-TF'
  diagonalization  = 'david'
/

ATOMIC_SPECIES
  Co1  58.933195  Co.rel-pbesol-spn-kjpaw_psl.0.3.1.UPF
  Co2  58.933195  Co.rel-pbesol-spn-kjpaw_psl.0.3.1.UPF
  F    18.998403  F.oncvpsp.upf

ATOMIC_POSITIONS crystal
  Co1  0.0000000000  0.0000000000  0.0000000000
  Co2  0.5000000000  0.5000000000  0.5000000000
  F    0.1957467430  0.8042532570  0.5000000000
  F    0.8042532570  0.1957467430  0.5000000000
  F    0.6957467430  0.6957467430  0.0000000000
  F    0.3042532570  0.3042532570  0.0000000000

K_POINTS automatic
  8 8 12 0 0 0

HUBBARD ortho-atomic
  U Co1-3d 6.26
  U Co2-3d 6.26
