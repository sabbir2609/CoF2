&CONTROL
  calculation   = 'scf'
  outdir        = './out/'
  prefix        = 'aiida'
  pseudo_dir    = './pseudo/'
  verbosity     = 'high'
/

&SYSTEM
  ibrav         = 0
  nat           = 6
  ntyp          = 3
  nspin         = 2
  nosym         = .false.
  ecutwfc       = 90.0
  ecutrho       = 1080.0
